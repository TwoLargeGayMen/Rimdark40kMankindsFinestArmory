<ThingDef ParentName="Seg_GG_MeleePowerWeapon_base">
		<defName>Seg_GG_PlagueSwordPB</defName>
		<label>plague sword</label>
		<description>Plagued blades bring life with each cut.\n\nThis is a daemonic weapon, roughly in the form of a mortal sword, infused with so much rot and disease that the barest scratch is enough to bestow the blessings of the Grandfather - or to bring death. Those whose bloodstream is flooded with Nurgle's rot may even rise again as plaguebearers when their bodies are consumed by decay.</description>
		<soundInteract>Seg_COTO_PoweredMeleeWeaponEquipSound</soundInteract>
		<meleeHitSound>Seg_COTO_PoweredMeleeWeaponImpactSound</meleeHitSound>
		<equippedAngleOffset>-60</equippedAngleOffset>
		<smeltable>false</smeltable>
		<tradeability>None</tradeability>
		<weaponClasses>
			<li>MeleePiercer</li>
		</weaponClasses>
		<graphicData>
			<texPath>Things/Weapons/Melee/seg_DG_Plaguesword</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.1</drawSize>
		</graphicData>
		<uiIconScale>1.1</uiIconScale>
		<statBases>
			<WorkToMake>48000</WorkToMake>
			<Mass>4</Mass>
			<MarketValue>2000</MarketValue>
		</statBases>
		<costList>
			<Steel>35</Steel>
			<Plasteel>100</Plasteel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<recipeMaker>
			<researchPrerequisites>
				<li>LongBlades</li>
			</researchPrerequisites>
			<recipeUsers>
				<li>FabricationBench</li> <!-- change to Nurgle's Cauldron-->
			</recipeUsers>
			<skillRequirements>
				<Crafting>12</Crafting>
			</skillRequirements>
			<displayPriority>400</displayPriority>
		</recipeMaker>
		<weaponTags>
			<li>Seg_GG_PlagueBearer</li>
		</weaponTags>		
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<cooldownTime>1.6</cooldownTime>
			</li>
			<li>
				<label>point</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>25</power>
				<cooldownTime>3.2</cooldownTime>
				<armorPenetration>0.9</armorPenetration>
			</li>
			<li>
				<label>edge</label>
